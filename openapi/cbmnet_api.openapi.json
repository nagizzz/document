    "/video/supply/save": {
      "post": {
        "summary": "绑定视频至供应产品",
        "description": "一个产品仅允许一个未删除视频。产品先保存或七牛回调先到均可处理；供应视频只在转码完成后发起内容审核。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id",
                  "video_key"
                ],
                "properties": {
                  "product_id": {
                    "type": "integer",
                    "example": 10001,
                    "description": "product_id 字段。"
                  },
                  "video_key": {
                    "type": "string",
                    "example": "supply-video/20260812/example.mp4",
                    "description": "video_key 字段。"
                  },
                  "uid": {
                    "type": "integer",
                    "example": 746675,
                    "description": "uid 字段。"
                  },
                  "title": {
                    "type": "string",
                    "example": "测试石材",
                    "description": "title 字段。"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "product_id": 10001,
                    "video_key": "supply-video/20260812/example.mp4",
                    "uid": 746675,
                    "title": "测试石材"
                  }
                }
              }
            }
          }
        },
