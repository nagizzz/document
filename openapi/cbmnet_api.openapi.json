    "/video/supply/token": {
      "post": {
        "summary": "获取七牛直传凭证",
        "description": "返回短期上传 token 与指定 key。客户端使用七牛 SDK 直传，不得持有 AK/SK。供应产品视频上传凭证内置 100MB 文件大小上限，直传端不可绕过。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "extension"
                ],
                "properties": {
                  "extension": {
                    "type": "string",
                    "description": "视频扩展名，仅支持 mp4、mov、avi、mkv、flv、wmv、webm、m4v",
                    "example": "mp4"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "extension": "mp4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求处理结果。Code 为 200 表示成功；其余业务状态码表示参数、资源或处理错误。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Code": {
                      "type": "integer",
                      "description": "业务状态码。",
                      "example": 200
                    },
                    "Msg": {
                      "type": "string",
                      "description": "结果说明。",
                      "example": "获取上传 token 成功"
                    },
                    "Data": {
                      "type": "object",
                      "description": "七牛直传凭证。",
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "建议上传使用的对象 key。",
                          "example": "supply-video/20260819/example.mp4"
                        },
                        "domain": {
                          "type": "string",
                          "description": "视频访问域名。",
                          "example": "https://video.example.com/"
                        },
                        "token": {
                          "type": "string",
                          "description": "七牛上传 token。",
                          "example": "qiniu-upload-token"
                        }
                      }
                    }
                  },
                  "example": {
                    "Code": 200,
                    "Msg": "获取上传 token 成功",
                    "Data": {
                      "key": "supply-video/20260819/example.mp4",
                      "domain": "https://video.example.com/",
                      "token": "qiniu-upload-token"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "Code": 200,
                      "Msg": "获取上传 token 成功",
                      "Data": {
                        "key": "supply-video/20260819/example.mp4",
                        "domain": "https://video.example.com/",
                        "token": "qiniu-upload-token"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "video"
        ]
      }
