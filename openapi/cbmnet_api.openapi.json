            "description": "请求处理结果。Code 为 200 表示成功；其余业务状态码表示参数、资源或处理错误。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Code": {
                      "type": "integer",
                      "description": "业务状态码。",
                      "example": 200
                    },
                    "Msg": {
                      "type": "string",
                      "description": "结果说明。",
                      "example": "获取成功"
                    },
                    "Data": {
                      "type": "object",
                      "description": "产品视频绑定状态。",
                      "properties": {
                        "has_video": {
                          "type": "boolean",
                          "description": "是否存在未删除的视频记录；处理中或审核失败时也为 true。",
                          "example": true
                        },
                        "video": {
                          "type": "object",
                          "example": "示例值",
                          "description": "已绑定的视频记录；未绑定时为 null。",
                          "nullable": true,
