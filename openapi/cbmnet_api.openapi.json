        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id"
                ],
                "properties": {
                  "product_id": {
                    "type": "integer",
                    "example": 10001,
                    "description": "product_id 字段。"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "product_id": 10001
                  }
                }
