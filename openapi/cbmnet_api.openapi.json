    "/video/supply/batch": {
      "post": {
        "summary": "批量获取可播放视频地址",
        "description": "仅返回转码成功、七牛审核通过且未删除的视频，Data 为 产品ID到视频 URL 的映射。",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_ids"
                ],
                "properties": {
                  "product_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      10001,
                      10002
                    ],
                    "description": "product_ids 字段。"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "product_ids": [
                      10001,
                      10002
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求处理结果。Code 为 200 表示成功；其余业务状态码表示参数、资源或处理错误。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Code": {
                      "type": "integer",
                      "description": "业务状态码。",
                      "example": 200
                    },
                    "Msg": {
                      "type": "string",
                      "description": "结果说明。",
                      "example": "获取成功"
                    },
                    "Data": {
                      "type": "object",
                      "description": "产品 ID 到可播放视频 URL 的映射；仅返回未删除、转码完成且审核通过的视频。",
                      "example": {
                        "10001": "https://video.example.com/supply-video/example.mp4"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "description": "视频访问 URL。",
                        "example": "https://video.example.com/supply-video/example.mp4"
                      }
                    }
                  },
                  "example": {
                    "Code": 200,
                    "Msg": "获取成功",
                    "Data": {
                      "10001": "https://video.example.com/supply-video/example.mp4"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "Code": 200,
                      "Msg": "获取成功",
                      "Data": {
                        "10001": "https://video.example.com/supply-video/example.mp4"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "video"
        ]
      }
    },
