    "/token/wechat": {
      "post": {
        "tags": [
          "voucher"
        ],
        "summary": "按 type 获取微信公众号 access_token",
        "description": "用于前端或中间层按业务类型获取微信基础接口 access_token。当前仅支持 type=cement_project，对应水泥项目通公众号。后续如新增其他公众号或项目，只需在 config/wechat.php 的 token_list 中追加配置，无需改接口逻辑。\n\n关键规则：\n1. type 为必填字段，当前可用值为 cement_project。\n2. 当前 type=cement_project 映射的公众号为“水泥项目通公众号”。\n3. 返回的 token 为微信官方 access_token，expires_in 为微信返回的秒数，前端或调用方应按 expires_in 做缓存，不要每次页面刷新都重复请求。\n4. 微信官方接口可能受 IP 白名单限制；如果公众号后台开启了白名单而当前服务出口 IP 未加入，微信会返回类似 40164 invalid ip 的错误。\n5. 当微信返回 errcode 或未返回 access_token 时，接口会直接返回失败信息。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "微信业务类型。当前固定传 cement_project，详见上方说明。",
                    "example": "cement_project"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "type": "cement_project"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "微信业务类型。当前固定传 cement_project，详见上方说明。",
                    "example": "cement_project"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "请求处理结果。Code 为 200 表示成功；其余业务状态码表示参数、资源或处理错误。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Code": {
                      "type": "integer",
                      "description": "业务状态码。",
                      "example": 200
                    },
                    "Msg": {
                      "type": "string",
                      "description": "结果说明。",
                      "example": "获取微信token成功"
                    },
                    "Data": {
                      "type": "object",
                      "description": "微信公众号 access_token 信息。",
                      "nullable": true,
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "命中的微信业务类型。",
                          "example": "cement_project"
                        },
                        "expires_in": {
                          "type": "integer",
                          "description": "有效期，单位秒。",
                          "example": 7200
                        },
                        "token": {
                          "type": "string",
                          "description": "微信官方 access_token。",
                          "example": "42_abcdefg1234567890"
                        },
                        "name": {
                          "type": "string",
                          "description": "公众号配置名称。",
                          "example": "水泥项目通公众号"
                        }
                      }
                    }
                  },
                  "example": {
                    "Code": 200,
                    "Msg": "获取微信token成功",
                    "Data": {
                      "type": "cement_project",
                      "expires_in": 7200,
                      "token": "42_abcdefg1234567890",
                      "name": "水泥项目通公众号"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "Code": 200,
                      "Msg": "获取微信token成功",
                      "Data": {
                        "type": "cement_project",
                        "expires_in": 7200,
                        "token": "42_abcdefg1234567890",
                        "name": "水泥项目通公众号"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
