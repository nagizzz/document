  "servers": [
    {
      "url": "{{ccement_user_behavior_api}}",
      "description": "用户行为分析项目变量。当前已知联调地址：http://analysis.api.ccement.com。当前文档的 paths 键已直接写成 {{ccement_user_behavior_api}}/接口路径，导入 APIPOST 后应直接显示完整 URL；后续如补充测试或正式环境，也继续在变量中切换。"
    }
  ],
  "tags": [
    {
      "name": "自定义事件统计",
      "description": "事件统计列表与导出接口"
    },
    {
      "name": "自定义事件配置",
      "description": "事件配置列表、新增、修改接口"
    },
    {
      "name": "页面描述管理",
      "description": "页面描述列表、写入和页面统计接口"
    }
  ],
  "components": {
    "schemas": {
      "doc01_______________openapi__DefineEventStatisticsRequest": {
        "type": "object",
        "description": "统计筛选参数。代码通过 Request::param() 读取，POST 表单和 JSON 都可。",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "开始日期，格式 yyyy-MM-dd。不传时由底层查询逻辑按现有默认行为处理。"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "结束日期，格式 yyyy-MM-dd。"
          },
          "model": {
            "type": "string",
            "description": "所属模块筛选。该筛选在控制器中对补充后的 model 字段做二次过滤，不参与底层统计 SQL。"
          },
          "sort": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "按 defineEventName 排序，默认 desc。除 asc 之外的值都会走 desc 分支。"
          },
          "export": {
            "type": "integer",
            "description": "传 1 时返回 Excel Base64 文件内容；不传或非 1 时返回统计列表。",
            "enum": [
              1
            ]
          },
          "platform": {
            "type": "integer",
            "description": "平台筛选。1=水泥网，2=数字新能源，3=混凝土网，4=新行情通网。若底层统计模型支持该参数，会按平台过滤；返回中同时给出 platformName。",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "port": {
            "type": "string",
            "description": "端口筛选，如 app、xcx、h5。该字段表示事件发生的客户端入口，不等同于 platform；是否生效取决于底层统计模型。"
          },
          "deviceType": {
            "type": "string",
            "description": "设备类型筛选。是否生效取决于底层统计模型。"
          },
          "defineEventName": {
            "type": "string",
            "description": "事件 ID 筛选，即埋点事件名/事件编码。是否生效取决于底层统计模型。"
          }
        }
      },
      "doc01_______________openapi__DefineEventStatisticsItem": {
        "type": "object",
        "description": "事件统计列表项。统计结果以 defineEventName、port、platform 为粒度分组，因此同一事件在不同平台或端口下会拆成多条记录。",
        "properties": {
          "defineEventName": {
            "type": "string",
            "description": "事件 ID。"
          },
          "defineEventDescription": {
            "type": "string",
            "description": "事件描述，来自统计结果自身。导出分支已不再回退旧 describe 变量。"
          },
          "count": {
            "type": "integer",
            "description": "命中次数。表示在当前日期范围、平台、端口、事件粒度下聚合后的总上报次数，不是去重用户数。"
          },
          "model": {
            "type": "string",
            "description": "所属模块。若配置表中未找到 ev_name + ev_platform 对应记录，则返回空字符串。"
          },
          "platform": {
            "type": "integer",
            "description": "所属平台原始枚举值。1=水泥网，2=数字新能源，3=混凝土网，4=新行情通网。",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "platformName": {
            "type": "string",
            "description": "所属平台中文名。1=水泥网，2=数字新能源，3=混凝土网，4=新行情通网；若出现历史异常值则返回空字符串。"
          },
          "port": {
            "type": "string",
            "description": "端口类型，例如 app、xcx、h5。与 platform 组合后共同决定一条统计记录的粒度。"
          }
        }
      },
      "doc01_______________openapi__DefineEventStatisticsListResponse": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "integer",
            "example": 200
          },
          "Msg": {
            "type": "string",
            "example": "成功"
          },
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/doc01_______________openapi__DefineEventStatisticsItem"
            }
          }
        }
      },
      "doc01_______________openapi__DefineEventStatisticsExportResponse": {
        "type": "object",
