              "schema": {
                "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigIndexRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "ev_platform": 1,
                    "page": 1,
                    "page_size": 10
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigIndexRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回分页列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigIndexResponse"
                }
              }
            }
          },
          "400": {
            "description": "业务异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/doc02_______________openapi__CommonErrorResponse"
