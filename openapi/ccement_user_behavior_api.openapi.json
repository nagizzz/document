              }
            }
          }
        }
      }
    },
    "/admin/defineeventconfig/store": {
      "post": {
        "tags": [
          "自定义事件配置"
        ],
        "summary": "新增事件配置",
        "description": "新增一条自定义事件配置。ev_platform 为必填且只允许 1/2/3/4，后端会显式写入 ev_platform，避免继续依赖 ClickHouse UInt8 默认值 0。id 由数据库生成，ev_addTime 由后端写入当前时间。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigStoreRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "ev_name": "page_view",
                    "ev_description": "页面访问事件",
                    "ev_model": "行为分析",
                    "ev_platform": 1
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigStoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回本次写入的数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/doc02_______________openapi__DefineEventConfigStoreResponse"
                }
              }
            }
          },
          "400": {
            "description": "校验失败或写入异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/doc02_______________openapi__CommonErrorResponse"
                },
                "examples": {
                  "missingPlatform": {
                    "value": {
                      "Code": 400,
                      "Msg": "所属平台必须传入",
                      "Data": []
                    }
                  },
                  "invalidPlatform": {
                    "value": {
                      "Code": 400,
                      "Msg": "所属平台取值无效，仅支持：1=水泥网,2=数字新能源,3=混凝土网,4=新行情通网",
                      "Data": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
