{
  "openapi": "3.0.3",
  "info": {
    "title": "ccement_user_behavior_api - APIPOST 聚合接口文档",
    "version": "2026.08.19",
    "description": "由本机 OpenAPI 聚合服务自动生成。请勿手工编辑此文件。"
