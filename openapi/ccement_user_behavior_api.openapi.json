  "paths": {
    "/admin/defineevent/statistics": {
      "post": {
        "tags": [
          "自定义事件统计"
        ],
        "summary": "获取事件统计详情或导出结果",
        "description": "按日期范围统计自定义事件数量。export=1 时返回 Excel Base64 字符串，导出列新增所属平台。列表与导出均会补充 platformName；所属模块 model 通过 user_defineEventConfig 表按 ev_name + ev_platform 查询，避免同一事件 ID 在多平台下共用模块信息。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/doc01_______________openapi__DefineEventStatisticsRequest"
              },
              "examples": {
                "list": {
                  "summary": "列表查询",
                  "value": {
                    "startDate": "2026-05-01",
                    "endDate": "2026-05-08",
                    "platform": 2,
                    "sort": "desc"
                  }
                },
                "export": {
                  "summary": "导出 Excel",
                  "value": {
                    "startDate": "2026-05-01",
                    "endDate": "2026-05-08",
                    "platform": 2,
                    "export": 1
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/doc01_______________openapi__DefineEventStatisticsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回。未导出时 Data 为统计列表；导出时 Data 为 Excel Base64 字符串。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/doc01_______________openapi__DefineEventStatisticsListResponse"
                    },
                    {
                      "$ref": "#/components/schemas/doc01_______________openapi__DefineEventStatisticsExportResponse"
                    }
                  ]
                },
                "examples": {
                  "list": {
                    "summary": "列表返回",
                    "value": {
                      "Code": 200,
                      "Msg": "成功",
                      "Data": [
                        {
                          "defineEventName": "Price_Statistic_PageView",
                          "defineEventDescription": "行情统计页浏览",
                          "count": 318,
                          "model": "行情统计",
                          "platform": 2,
                          "platformName": "数字新能源",
                          "port": "app"
                        }
                      ]
                    }
                  },
                  "export": {
                    "summary": "导出返回",
                    "value": {
                      "Code": 200,
                      "Msg": "成功",
                      "Data": "UEsDB..."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误或业务异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/doc01_______________openapi__CommonErrorResponse"
                }
              }
            }
          }
        }
      }
    },
