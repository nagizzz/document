    "/admin/pagedescribe/access": {
      "post": {
        "tags": [
          "页面描述管理"
        ],
        "summary": "页面访问详情统计",
        "description": "查询页面访问次数、访问人数、平均停留时长等指标。行为数据底层默认按 platform=1 过滤；补充页面中文描述时也只会读取同 platform 的页面字典，因此平台传错会直接导致描述缺失。",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/doc03____________openapi__PageDescribeStatisticsRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/doc03____________openapi__PageDescribeStatisticsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功返回统计结果"
          }
        }
      }
    },
